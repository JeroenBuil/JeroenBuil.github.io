{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "layer",
          "apply",
          "responsive",
          "screen",
          "utility"
        ]
      }
    ],
    "color-function-notation": "modern",
    "alpha-value-notation": "number",
    "import-notation": null
  }
}
